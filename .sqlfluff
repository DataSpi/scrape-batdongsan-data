[sqlfluff]
dialect = bigquery
templater = jinja
max_line_length = 120
# Style/layout rules disabled: they would force a mass-reformat of existing models.
# Kept on: syntax/parse errors, ambiguous refs (AM*), aliasing/convention bugs not listed here.
exclude_rules = AM04, AL01, CP02, CV03, LT01, LT02, LT04, LT05, LT08, LT09, RF02, RF04, ST01, ST05, ST06, ST07

[sqlfluff:templater:jinja]
apply_dbt_builtins = True
